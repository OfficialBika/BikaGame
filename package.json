{
  "name": "bika-bot-production",
  "version": "3.0.0",
  "description": "BIKA Pro Telegram game bot - modular production build",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "check": "node --check index.js && find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "migrate:transaction-history": "node scripts/migrate-transaction-history.js",
    "cleanup:game-history": "node scripts/cleanup-game-history.js",
    "clear:db1-transactions": "node scripts/clear-db1-transactions.js",
    "db:storage": "node scripts/db-storage-report.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mongodb": "^6.8.0",
    "telegraf": "^4.16.3"
  },
  "engines": {
    "node": ">=18"
  }
}
